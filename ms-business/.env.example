PORT=3000
MS_SECURITY_URL=http://localhost:8080
MS_BUSINESS_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

DB_URL=postgresql://<username>:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/<database>

# ePayco — recarga tarjeta prepagada (HU-ENTR-2-013)
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=
EPAYCO_TEST_MODE=true
EPAYCO_FEE_PERCENT=2.99
EPAYCO_MERCHANT_NAME=UCaldas Transporte
# Retorno del navegador y webhook (Apify exige URL pública válida; localhost se omite en checkout).
# En local: sin estas variables el checkout funciona; confirmar saldo vía statusPollUrl o GET /cards (sandbox).
# Producción / ngrok: URL HTTPS pública del backend.
# EPAYCO_RESPONSE_URL=https://api.tudominio.com/card-recharge/return
# EPAYCO_CONFIRMATION_URL=https://api.tudominio.com/card-recharge/webhook/confirmation
# EPAYCO_SKIP_SIGNATURE=true