PORT=3000
MS_SECURITY_URL=http://localhost:8080
# Mismo valor que MS_SECURITY_INTERNAL_KEY en ms-security (header X-Internal-Key)
MS_SECURITY_INTERNAL_KEY=<generate_random_32+_chars>
# Roles CITIZEN/DRIVER/SUPERVISOR: POST /api/internal/user-role/user/{userId}/role-name/{ROLE}
MS_BUSINESS_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Preferir pooler IPv4 (Transaction :6543). El host db.<ref>.supabase.co puede fallar sin IPv6.
# DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Notificaciones (incidentes / alertas de llegada)
# MS_NOTIFICATION_URL=http://localhost:8000
# NOTIFICATIONS_URL=http://localhost:8000

# ePayco — recarga tarjeta prepagada (HU-ENTR-2-013)
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=
# Default seguro: false. En local sandbox poner true explícitamente.
EPAYCO_TEST_MODE=false
EPAYCO_FEE_PERCENT=2.99
EPAYCO_MERCHANT_NAME=UCaldas Transporte
# Retorno del navegador y webhook (Apify exige URL pública válida; localhost se omite en checkout).
# En local: sin estas variables el checkout funciona; confirmar saldo vía confirm-local-test o GET /cards (sandbox).
# Producción / ngrok: URL HTTPS pública del backend.
# EPAYCO_RESPONSE_URL=https://api.tudominio.com/card-recharge/return
# EPAYCO_CONFIRMATION_URL=https://api.tudominio.com/card-recharge/webhook/confirmation
# Solo con EPAYCO_TEST_MODE=true (nunca en producción):
# EPAYCO_SKIP_SIGNATURE=true

# Supabase Storage (fotos)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# Fotos de flota (POST /bus/:id/photo) → bucket público en Supabase Storage
SUPABASE_BUS_BUCKET=bus-photo
# Fotos de incidentes (POST /incident-reports/driver)
# SUPABASE_INCIDENT_BUCKET=incident-report
