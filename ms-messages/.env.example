PORT=3001
NODE_ENV=development

# Same Postgres database as ms-business (shared schema: persons, tickets, routes, …)
# Copy DB_URL from ms-business/.env — messages tables are created by this service's migrations.
DB_URL=postgresql://user:password@localhost:5432/postgres

# ms-security base URL (no trailing slash). Required — no localhost fallback in code.
MS_SECURITY_URL=http://localhost:8080

# Same value as MS_SECURITY_INTERNAL_KEY in ms-security / ms-business (header X-Internal-Key).
# Required for user search and mass-alert ALL scope.
MS_SECURITY_INTERNAL_KEY=<generate_random_32+_chars>

# Comma-separated browser origins for HTTP + Socket.IO CORS.
# Required when NODE_ENV=production. In development, omit to reflect any origin.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
